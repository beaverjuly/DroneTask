# ── Pavlovia raw data ──────────────────────────────────────────
# Real Pavlovia filename: DroneTask_{pid}_SESSION_{date}_{time}.csv
analysis/data/*
!analysis/data/README.md
DroneTask_*_SESSION_*.csv

# Old pattern kept for backward compatibility
DroneTask_PARTICIPANT_SESSION_*.csv

# ── Local dev data ──────────────────────────────────────────────
# CSV downloads from ?dev=1 routes land in Downloads, not the repo,
# but this catches any accidentally placed ones.
drone_task_*.csv

